# Public build configuration only. Never put client secrets or tokens in VITE_* variables.
# Keep disabled until using your OWN Microsoft Entra SPA registration.
VITE_EXPERIMENTAL_SCHOOL_LOGIN=false
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
# Register this exact URI as a Single-page application redirect.
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/redirect.html
