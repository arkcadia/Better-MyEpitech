# Public build switch, not a credential. See docs/setup/google-calendar.md.
# Enable after registering your Android package + signing SHA-1 in Google Cloud.
EXPO_PUBLIC_GOOGLE_CALENDAR_ENABLED=false

# Exact school-authorized HTTPS file hosts; comma-separated, no URLs/tokens/wildcards.
# See docs/setup/documents.md. Empty allows only my.epitech.eu.
EXPO_PUBLIC_DOCUMENT_DOWNLOAD_HOSTS=
