{
  "name": "better-myepitech",
  "description": "Android and web Epitech companion with shared student-data collection.",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-modules-core": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:android": "expo export --platform android",
    "web": "npm run dev --workspace @better-myepitech/web",
    "build:web": "npm run build --workspace @better-myepitech/web",
    "typecheck:web": "npm run typecheck --workspace @better-myepitech/web",
    "preview:web": "npm run preview --workspace @better-myepitech/web"
  },
  "workspaces": [
    "apps/web"
  ]
}
